{
	// Builds l4d2vr.sln (x64) with the MSBuild of Visual Studio 2022. The post-build event
	// copies d3d11.dll into Portal Revolution's bin\win64, so the game must not be running.
	"version": "2.0.0",
	"tasks": [
		{
			// Optimized with Release CRT, but with full PDB and the diagnostics (log file, crash log)
			"label": "Build RelWithDebInfo (x64)",
			"type": "process",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				"l4d2vr.sln",
				"/m",
				"/nologo",
				"/p:Configuration=RelWithDebInfo",
				"/p:Platform=x64",
				"/p:GenerateFullPaths=true",
				"/clp:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build Debug (x64)",
			"type": "process",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				"l4d2vr.sln",
				"/m",
				"/nologo",
				"/p:Configuration=Debug",
				"/p:Platform=x64",
				"/p:GenerateFullPaths=true",
				"/clp:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		},
		{
			"label": "Build Release (x64)",
			"type": "process",
			"command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
			"args": [
				"l4d2vr.sln",
				"/m",
				"/nologo",
				"/p:Configuration=Release",
				"/p:Platform=x64",
				"/p:GenerateFullPaths=true",
				"/clp:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": "build"
		}
	]
}
